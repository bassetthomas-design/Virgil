<UserControl x:Class="Virgil.App.Controls.VirgilAvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="240"
             d:DesignWidth="240">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="AccentStrokeBrush" Color="#804CAF50" />
        <SolidColorBrush x:Key="FaceFillBrush" Color="#0F181A" />
        <SolidColorBrush x:Key="EyeTintBrush" Color="#F2FBF5" />
        <SolidColorBrush x:Key="EyeOutlineBrush" Color="#66FFFFFF" />
    </UserControl.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox Stretch="Uniform">
            <Grid Width="220" Height="220">
                <Ellipse Fill="{StaticResource FaceFillBrush}"
                         Stroke="{StaticResource AccentStrokeBrush}"
                         StrokeThickness="6"
                         x:Name="FaceEllipse">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="FaceGlow"
                                          Color="#884CAF50"
                                          BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Stroke="{StaticResource AccentBrush}"
                         StrokeThickness="5"
                         Width="220"
                         Height="220"
                         x:Name="AccentRing">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="RingGlow"
                                          Color="#884CAF50"
                                          BlurRadius="16"
                                          ShadowDepth="0"
                                          Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>

                <Grid x:Name="EyesLayer"
                      Width="140"
                      Height="64"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyesOffset" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Grid x:Name="LeftEye"
                          Width="58"
                          Height="32"
                          HorizontalAlignment="Left"
                          Margin="6,0,0,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LeftEyeScale" />
                                <TranslateTransform x:Name="LeftEyeOffset" X="-8" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid.Clip>
                            <RectangleGeometry x:Name="LeftEyeClip" Rect="0,0,58,32" />
                        </Grid.Clip>
                        <Path Stretch="Fill"
                              Data="M2,16 C7,5 26,2 40,3 C50,4 56,9 56,16 C56,23 50,28 40,29 C26,30 7,27 2,16 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,0.9">
                                    <GradientStop Color="#FFFDFD" Offset="0" />
                                    <GradientStop Color="{Binding Color, Source={StaticResource EyeTintBrush}}" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Ellipse Width="12"
                                 Height="8"
                                 Fill="#CCFFFFFF"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="10,6,0,0" />
                        <Path Stretch="Fill"
                              Data="M2,16 C7,5 26,2 40,3 C50,4 56,9 56,16 C56,23 50,28 40,29 C26,30 7,27 2,16 Z"
                              Stroke="{StaticResource EyeOutlineBrush}"
                              StrokeThickness="1.6" />
                    </Grid>

                    <Grid x:Name="RightEye"
                          Width="58"
                          Height="32"
                          HorizontalAlignment="Right"
                          Margin="0,0,6,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RightEyeScale" />
                                <TranslateTransform x:Name="RightEyeOffset" X="8" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid.Clip>
                            <RectangleGeometry x:Name="RightEyeClip" Rect="0,0,58,32" />
                        </Grid.Clip>
                        <Path Stretch="Fill"
                              Data="M2,16 C7,5 26,2 40,3 C50,4 56,9 56,16 C56,23 50,28 40,29 C26,30 7,27 2,16 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,0.9">
                                    <GradientStop Color="#FFFDFD" Offset="0" />
                                    <GradientStop Color="{Binding Color, Source={StaticResource EyeTintBrush}}" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Ellipse Width="12"
                                 Height="8"
                                 Fill="#CCFFFFFF"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="10,6,0,0" />
                        <Path Stretch="Fill"
                              Data="M2,16 C7,5 26,2 40,3 C50,4 56,9 56,16 C56,23 50,28 40,29 C26,30 7,27 2,16 Z"
                              Stroke="{StaticResource EyeOutlineBrush}"
                              StrokeThickness="1.6" />
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
