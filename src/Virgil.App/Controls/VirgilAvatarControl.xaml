<UserControl x:Class="Virgil.App.Controls.VirgilAvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="240"
             d:DesignWidth="240">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="AccentStrokeBrush" Color="#804CAF50" />
        <SolidColorBrush x:Key="FaceFillBrush" Color="#0F181A" />
        <RadialGradientBrush x:Key="EyeFillBrush"
                             Center="0.4,0.35"
                             GradientOrigin="0.32,0.28"
                             RadiusX="0.95"
                             RadiusY="0.95">
            <GradientStop Color="#FF4CAF50" Offset="0" />
            <GradientStop Color="#CC4CAF50" Offset="0.32" />
            <GradientStop Color="#994CAF50" Offset="1" />
        </RadialGradientBrush>
    </UserControl.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Viewbox Stretch="Uniform">
            <Grid Width="220" Height="220">
                <Ellipse Fill="{StaticResource FaceFillBrush}"
                         Stroke="{StaticResource AccentStrokeBrush}"
                         StrokeThickness="6"
                         x:Name="FaceEllipse">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="FaceGlow"
                                          Color="#884CAF50"
                                          BlurRadius="24"
                                          ShadowDepth="0"
                                          Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Stroke="{StaticResource AccentBrush}"
                         StrokeThickness="5"
                         Width="220"
                         Height="220"
                         x:Name="AccentRing">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="RingGlow"
                                          Color="#884CAF50"
                                          BlurRadius="16"
                                          ShadowDepth="0"
                                          Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>

                <Grid x:Name="EyesLayer"
                      Width="130"
                      Height="56"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="EyesOffset" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Grid x:Name="LeftEyeContainer"
                          RenderTransformOrigin="0.5,0.5"
                          Width="32"
                          Height="32"
                          HorizontalAlignment="Left"
                          Margin="12,0,0,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LeftEyeScale" />
                                <TranslateTransform x:Name="LeftEyeOffset" X="-8" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Ellipse x:Name="LeftEye"
                                 Width="32"
                                 Height="32"
                                 Fill="{StaticResource EyeFillBrush}"
                                 Opacity="0.95">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"
                                                  Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <Grid x:Name="RightEyeContainer"
                          RenderTransformOrigin="0.5,0.5"
                          Width="32"
                          Height="32"
                          HorizontalAlignment="Right"
                          Margin="0,0,12,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RightEyeScale" />
                                <TranslateTransform x:Name="RightEyeOffset" X="8" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Ellipse x:Name="RightEye"
                                 Width="32"
                                 Height="32"
                                 Fill="{StaticResource EyeFillBrush}"
                                 Opacity="0.95">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"
                                                  Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
