<UserControl x:Class="Virgil.App.Controls.AvatarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Virgil.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="280" d:DesignHeight="180">
    <Grid>
        <Border Background="#1A1A22" CornerRadius="140"/>

        <controls:VirgilAvatarControl x:Name="VectorAvatar"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="220"
                                       Height="220"
                                       Visibility="Collapsed"
                                       Stress="{Binding AvatarTelemetry.Stress}"
                                       IsWorking="{Binding IsWorking, RelativeSource={RelativeSource AncestorType=controls:AvatarControl}}" />

        <Image x:Name="LegacyAvatar"
               Stretch="Uniform"
               Source="{Binding AvatarSource}"/>
    </Grid>
</UserControl>
