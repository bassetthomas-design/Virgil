<UserControl x:Class="Virgil.App.Views.MetricsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
        <WrapPanel ItemHeight="24" ItemWidth="Auto">
            <TextBlock Text="CPU:" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding CpuUsageText}" Margin="0,0,12,0"/>
            <TextBlock Text="Temp:" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding CpuTempText}" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding GpuHeaderText}" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding GpuUsageDisplayText}" Margin="0,0,12,0"/>
            <TextBlock Text="Temp:" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding GpuTempText}" Margin="0,0,12,0"/>
            <TextBlock Text="RAM:" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding RamUsageText}" Margin="0,0,12,0"/>
            <TextBlock Text="Disk:" FontWeight="SemiBold" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding DiskUsageText}" Margin="0,0,12,0"/>
        </WrapPanel>
        <!-- Mood state label for quick read -->
        <TextBlock Text="{Binding Mood}" Opacity="0.8" FontSize="12"/>
    </StackPanel>
</UserControl>
