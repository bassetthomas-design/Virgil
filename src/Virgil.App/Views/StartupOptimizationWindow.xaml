<Window x:Class="Virgil.App.Views.StartupOptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optimiser le démarrage"
        Height="520"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#141418"
        Foreground="#E6E6E6">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#1B1B20"
                  RowBackground="#141418">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Setter Property="ToolTip" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEssential}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="ToolTip" Value="Élément protégé"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Emplacement" Binding="{Binding Location}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Commande" Binding="{Binding Command}" Width="3*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Recommandé" Width="130" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Padding="6,2"
                                    CornerRadius="8"
                                    Background="#3A2E58"
                                    HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="Recommandé" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Tout cocher recommandé" Click="SelectRecommended_Click" Margin="0,0,8,0"/>
            <Button Content="Tout décocher" Click="DeselectAll_Click" Margin="0,0,8,0"/>
            <Button Content="Annuler" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Appliquer la sélection" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
