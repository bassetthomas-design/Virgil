<Window x:Class="Virgil.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Virgil.App.Converters"
        Title="Réglages" Height="640" Width="520">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" Width="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="OK" Width="90" IsDefault="True" Click="OnOk"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Monitoring" FontWeight="Bold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Intervalle min (min):" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="120" Text="{Binding MonitoringIntervalMinutesMin}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Intervalle max (min):" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="120" Text="{Binding MonitoringIntervalMinutesMax}"/>
                </StackPanel>

                <TextBlock Text="Chat" FontWeight="Bold" Margin="0,8,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Durée msg (ms):" Width="140" VerticalAlignment="Center"/>
                    <TextBox Width="120" Text="{Binding DefaultMessageTtlMs}"/>
                </StackPanel>

                <TextBlock Text="Avatar" FontWeight="Bold" Margin="0,8,0,6"/>
                <CheckBox Content="Battement léger (EnableBeatPulse)" IsChecked="{Binding EnableBeatPulse}"/>

                <TextBlock Text="Compagnon" FontWeight="Bold" Margin="0,8,0,6"/>
                <CheckBox Content="Bavard (CompanionTalkative)" IsChecked="{Binding CompanionTalkative}"/>

                <TextBlock Text="IA" FontWeight="Bold" Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Provider:" Width="140" VerticalAlignment="Center"/>
                    <ComboBox Width="200"
                              ItemsSource="{Binding AiProviderOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedAiProvider}"/>
                </StackPanel>
                <TextBlock Text="{Binding ProviderStatusText}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding GgufStatusText}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeStatusText}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeProcessStatusText}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimePortStatusText}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeSecurityFlagsText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeSecurityStrategyText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeLastErrorText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeExitCodeText}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeCommandLineText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding RuntimeStderrText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding OpenAiStatusText}" Margin="0,0,0,6"/>

                <TextBlock Text="OpenAI" FontWeight="Bold" Margin="0,10,0,6"/>
                <TextBlock Text="Clé OpenAI:" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="OpenAiKeyBox"
                                 Grid.Column="0"
                                 PasswordChanged="OnOpenAiKeyPasswordChanged"
                                 Visibility="{Binding IsOpenAiKeyVisible, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <TextBox x:Name="OpenAiKeyTextBox"
                             Grid.Column="0"
                             Text="{Binding OpenAiApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsOpenAiKeyVisible, Converter={StaticResource BoolToVisibility}}"/>
                    <ToggleButton Grid.Column="1"
                                  Content="{Binding OpenAiKeyToggleText}"
                                  IsChecked="{Binding IsOpenAiKeyVisible}"
                                  Margin="8,0,0,0"
                                  Checked="OnOpenAiKeyVisibilityChanged"
                                  Unchecked="OnOpenAiKeyVisibilityChanged"/>
                </Grid>
                <TextBlock Text="{Binding OpenAiKeyStatusText}" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Enregistrer" Command="{Binding SaveAiSettingsCommand}" Margin="0,0,8,8"/>
                    <Button Content="Tester OpenAI" Command="{Binding TestOpenAiCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <TextBlock Text="{Binding OpenAiTestResponseText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="Statut Pack Full:"/>
                <TextBlock Text="{Binding PackStatusText}" FontWeight="SemiBold" Margin="0,2,0,6"/>
                <TextBlock Text="{Binding ModelStatusText}" FontWeight="SemiBold" Margin="0,2,0,2"/>
                <TextBlock Text="{Binding ModelPathText}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding ModelAgeText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock Text="IA locale sélectionnée : Pack Full manquant. Installez-le pour activer l’IA offline."
                           Margin="0,0,0,6"
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowPackInstallPrompt, Converter={StaticResource BoolToVisibility}}"/>

                <ProgressBar Height="16"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding DownloadProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsDownloadIndeterminate}"
                             Margin="0,4,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding DownloadStatusText}" Width="260" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DownloadSpeedText}" HorizontalAlignment="Right"/>
                </StackPanel>

                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Installer Pack Full" Command="{Binding InstallPackCommand}" Margin="0,0,8,8"/>
                    <Button Content="Annuler" Command="{Binding CancelDownloadCommand}" Margin="0,0,8,8"/>
                    <Button Content="Vérifier" Command="{Binding VerifyPackCommand}" Margin="0,0,8,8"/>
                    <Button Content="Tester IA" Command="{Binding TestAiCommand}" Margin="0,0,8,8"/>
                </WrapPanel>

                <TextBlock Text="{Binding AiTestResponseText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
